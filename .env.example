# 环境变量配置
# 应用
APP_NAME=membrane-engineering-knowledge-agent
APP_ENV=dev
APP_DEBUG=true

# Runtime: local mode works without external services
RUNTIME_MODE=local
MODEL_MODE=fake
MODEL_PROVIDER=auto
PARSER_MODE=basic
LOCAL_DATA_PATH=data/processed
LOCAL_UPLOAD_PATH=data/uploads
LOCAL_DB_PATH=data/runtime/engineering.db
LONG_TERM_MEMORY_ENABLED=true
SHORT_TERM_MEMORY_TTL=86400

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=engineering
DB_PASSWORD=engineering123
DB_NAME=engineering_db
DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=engineering-docs
MINIO_SECURE=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DOCUMENT_COLLECTION=engineering_document_chunks
MILVUS_MEMORY_COLLECTION=engineering_long_term_memory

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=engineering123


DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GATEWAY_API_KEY=
GATEWAY_API_BASE=
GATEWAY_MODEL=
GATEWAY_EMBEDDING_MODEL=
CHAT_MODEL=deepseek-chat
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
EMBEDDING_PROVIDER=auto
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=
VL_MODEL=qwen-vl
MINERU_TIMEOUT=900

MINERU_API_URL=
MINERU_EXECUTABLE=F:\code\homework\project\1_membrane_project_precheck\runtime\envs\mineru\Scripts\mineru.exe
MINERU_WORK_ROOT=F:\code\homework\model-cache\mineru
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=ch

# Optional enterprise profiles
DEEPAGENTS_ENABLED=false
DEEPAGENTS_TIMEOUT_SECONDS=300
TEMPORAL_ENABLED=false
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_TASK_QUEUE=membrane-engineering
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC_PREFIX=membrane

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs
