# 环境变量配置
# 应用
APP_NAME=membrane-engineering-knowledge-agent
APP_ENV=dev
APP_DEBUG=true

# Runtime: local mode works without external services
RUNTIME_MODE=local
AUTH_ENABLED=false
JWT_SECRET=local-development-only-change-me
DEFAULT_TENANT_ID=membrane-company
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin-change-me
DEFAULT_PROJECT_ID=demo-project
MODEL_MODE=fake
MODEL_PROVIDER=gateway
PARSER_MODE=basic
LOCAL_DATA_PATH=data/processed
LOCAL_UPLOAD_PATH=data/uploads
LOCAL_DB_PATH=data/runtime/engineering.db
LONG_TERM_MEMORY_ENABLED=true
SHORT_TERM_MEMORY_TTL=86400

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=engineering
DB_PASSWORD=engineering123
DB_NAME=engineering_db
DATABASE_URL=

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=engineering-docs
MINIO_SECURE=false

DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://ws-ac3tb94f5a4aonc8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-flash
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://www.vibeapi.cn/v1
DEEPSEEK_MODEL=deepseek-v4-flash
GATEWAY_API_KEY=
GATEWAY_API_BASE=https://www.vibeapi.cn/v1
GATEWAY_MODEL=deepseek-v4-flash
GATEWAY_EMBEDDING_MODEL=text-embedding-v4
CHAT_MODEL=deepseek-v4-flash
REVIEW_API_BASE=https://ws-ac3tb94f5a4aonc8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
REVIEW_API_KEY=
REVIEW_MODEL=qwen3.7-flash
REVIEW_MAX_TOKENS=8192
REVIEW_SUPERVISOR_ENABLED=true
MODEL_RETRY_ATTEMPTS=2
MODEL_RETRY_BACKOFF_SECONDS=0.5
MODEL_TIMEOUT_SECONDS=180
MODEL_CONTEXT_WINDOW=32768
EMBEDDING_PROVIDER=embedding
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://ws-ac3tb94f5a4aonc8.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
RERANKER_ENABLED=true
RERANKER_PROVIDER=dashscope
RERANKER_API_BASE=https://ws-ac3tb94f5a4aonc8.cn-beijing.maas.aliyuncs.com/compatible-api/v1/reranks
RERANKER_API_KEY=
RERANKER_MODEL=qwen3-rerank
RERANKER_TOP_N=8
RERANKER_INSTRUCT=Given an engineering question, retrieve passages that directly answer it.
VL_MODEL=qwen-vl
MINERU_TIMEOUT=900

MINERU_API_URL=
MINERU_EXECUTABLE=F:\code\homework\project\1_membrane_project_precheck\runtime\envs\mineru\Scripts\mineru.exe
MINERU_WORK_ROOT=F:\code\homework\model-cache\mineru
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=ch

# Workflow and observability
TEMPORAL_ENABLED=false
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_TASK_QUEUE=membrane-engineering
TEMPORAL_PARSE_TASK_QUEUE=membrane-document-parse
TEMPORAL_REVIEW_TASK_QUEUE=membrane-agent-review
TEMPORAL_MAINTENANCE_TASK_QUEUE=membrane-maintenance
BATCH_DOCUMENT_LIMIT=100
BATCH_CHILD_CONCURRENCY=5
DEFAULT_DAILY_TOKEN_LIMIT=1000000
DEFAULT_MONTHLY_COST_LIMIT_MICROS=100000000
DEFAULT_MAX_CONCURRENT_REVIEWS=3
MODEL_ESTIMATED_COST_MICROS_PER_1K_TOKENS=2000
API_RATE_LIMIT_PER_MINUTE=60
MCP_ENABLED=false
MCP_HOST=127.0.0.1
MCP_PORT=8090
MCP_AUDIENCE=membrane-mcp
MCP_CLIENT_ID=membrane-enterprise-client
MCP_TOKEN_TTL_MINUTES=60
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8090/mcp
MCP_ISSUER_URL=http://127.0.0.1:8080
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_CONTENT=false

# 日志
LOG_LEVEL=DEBUG
LOG_DIR=logs
