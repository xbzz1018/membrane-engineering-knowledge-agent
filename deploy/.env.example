# Generate actual random credentials with scripts/init_deployment.py.
COMPOSE_PROJECT_NAME=membrane-review
WEB_BIND=127.0.0.1
WEB_PORT=8088
POSTGRES_PASSWORD=replace-me
TEMPORAL_DB_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ROOT_USER=membrane
MINIO_ROOT_PASSWORD=replace-me
JWT_SECRET=replace-me
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-me

# The default proves storage/workflow wiring only, not semantic quality.
MODEL_MODE=fake
MODEL_PROVIDER=fake
GATEWAY_API_BASE=
GATEWAY_API_KEY=
GATEWAY_MODEL=
REVIEW_API_BASE=
REVIEW_API_KEY=
REVIEW_MODEL=
EMBEDDING_PROVIDER=embedding
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=demo-hash-1024
EMBEDDING_DIMENSIONS=1024
RERANKER_ENABLED=false
RERANKER_PROVIDER=dashscope
RERANKER_API_BASE=
RERANKER_API_KEY=
RERANKER_MODEL=

# Base image supports TXT/native Office. PDF/OCR needs a custom MinerU image.
# Keep mineru selected: an unavailable PDF/OCR parser fails explicitly.
PARSER_MODE=mineru
MINERU_EXECUTABLE=/opt/mineru/bin/mineru
MINERU_WORK_ROOT=/app/data/uploads/mineru
MINERU_API_URL=
APP_IMAGE=membrane-review-app:local
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8090/mcp
MCP_ISSUER_URL=http://127.0.0.1:8088
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8088
